#-----------------------------------------------------------------------------
# Title      : Yosys synthesis rules for the Makefile generated by edalize (ghdl)
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : yosys_synth.mk
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: Included at the end of the Makefile generated by edalize by
#              yosys_synth.sh (pre_run hook of the syn_* targets).
#              Makes "make run" (run step of fusesoc) synthesize the toplevel
#              with Yosys and its GHDL plugin (yosys -m ghdl), with the
#              options of the fusesoc target (as ghdl_synth.mk : STD,
#              ANALYZE_OPTIONS, TOPLEVEL_LIBS, TOPLEVEL and the generics in
#              EXTRA_OPTIONS), in two flows :
#              - xc7  : Xilinx Artix-7 (synth_xilinx)
#              - asic : standard cells of the liberty ASIC_LIBERTY
#                       (sky130_fd_sc_hd, typical corner, in the asylum-env
#                       image). There is no SRAM macro : the memories
#                       become flip-flops.
#              Each flow writes $(TOPLEVEL)_<flow>.log (yosys log) and
#              $(TOPLEVEL)_<flow>.json (stat -json), then yosys_synth.py
#              writes the summary $(TOPLEVEL)_syn.json and prints it
#              (LUT, LUTRAM, FF, BRAM, DSP ; area in um2).
#-----------------------------------------------------------------------------
# Copyright (c) 2026
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2026-11-20  1.0      mrosiere Created
#-----------------------------------------------------------------------------

ifeq ($(ASIC_LIBERTY),)
$(error yosys_synth.mk : ASIC_LIBERTY (liberty file of the asic flow) is not set)
endif

YOSYS             ?= yosys -m ghdl

# Yosys keeps the double quotes of the string generics (-gNAME="value"):
# remove them (the values of the fusesoc parameters have no space)
YOSYS_GHDL         = ghdl $(STD) $(ANALYZE_OPTIONS) $(TOPLEVEL_LIBS) $(subst ",,$(EXTRA_OPTIONS)) $(TOPLEVEL)

# Synthesis and statistics options of each flow
YOSYS_SYNTH_xc7    = synth_xilinx -flatten -noiopad -noclkbuf -top $(TOPLEVEL)
YOSYS_STAT_xc7     =
YOSYS_SYNTH_asic   = synth -flatten -top $(TOPLEVEL); dfflibmap -liberty $(ASIC_LIBERTY); abc -liberty $(ASIC_LIBERTY); opt_clean
YOSYS_STAT_asic    = -liberty $(ASIC_LIBERTY)

# Warnings of the liberty parser (scan flip-flops), not about the design
YOSYS_NOWARN       = -w "unsupported expression"

#--------------------------------------------------------
# Synthesis before the ghdl -r of the run rule
run : yosys_synth
#--------------------------------------------------------

#--------------------------------------------------------
# Summary of the two flows
yosys_synth : yosys_xc7 yosys_asic
#--------------------------------------------------------
	@python3 yosys_synth.py $(TOPLEVEL)

#--------------------------------------------------------
# One flow : yosys_xc7 or yosys_asic
yosys_xc7 yosys_asic : yosys_% : $(TOPLEVEL)
#--------------------------------------------------------
	$(EDALIZE_LAUNCHER) $(YOSYS) -q $(YOSYS_NOWARN) -l $(TOPLEVEL)_$*.log \
	  -p '$(YOSYS_GHDL); $(YOSYS_SYNTH_$*); stat $(YOSYS_STAT_$*); tee -q -o $(TOPLEVEL)_$*.json stat -json $(YOSYS_STAT_$*)'

.PHONY : yosys_synth yosys_xc7 yosys_asic
