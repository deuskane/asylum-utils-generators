REGTOOL       = {{ python }} {{ regtool }}
REGTOOL_OPT   =  --logical_name {{ libname }}
{%- if interface %}
REGTOOL_OPT  +=  --interface {{ interface }}
{%- endif %}

# Generated files depend on the regtool sources (scripts and schema)
REGTOOL_DIR   = {{ dir_script }}/tools/regtool
REGTOOL_FILES = $(shell find $(REGTOOL_DIR) -maxdepth 1 -type f \( -name '*.py' -o -name '*.hjson' \))

FILE_IN       = {{ file_in }}
{%- for file, option in outputs %}
FILES_OUT    += {{ file }}
{%- endfor %}

{% if copy_dir -%}
COPY_DIR      = {{ copy_dir }}
all      : $(addprefix $(COPY_DIR)/,$(notdir $(FILES_OUT)))

$(COPY_DIR) :
	mkdir -p "$@"
{% for file, option in outputs %}
$(COPY_DIR)/$(notdir {{ file }}) : {{ file }} | $(COPY_DIR)
	cp $< $@
{% endfor %}
{%- else -%}
all      : $(FILES_OUT)
{% endif %}
{%- for file, option in outputs %}
{{ file }} : \
  $(FILE_IN) $(REGTOOL_FILES)
	$(REGTOOL) $(REGTOOL_OPT) $< {{ option }} $@
{% endfor %}
clean :
	rm -f $(FILES_OUT)
